worker_processes auto;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 4096; }

stream {
    resolver 127.0.0.11 valid=10s ipv6=off;
    # Keep the HTTP ALPN / distinct web SNI fast paths. Ambiguous TLS (including
    # no-SNI/no-ALPN) is terminated on :5349, then classified as HTTP or STUN.
    # Neither SNI nor ALPN is required by ordinary HTTPS/WSS clients.
    map $ssl_preread_server_name $sni_backend {
        @WEB_SNI_ROUTE@
        default 127.0.0.1:5349;
    }
    map $ssl_preread_alpn_protocols $tls_backend {
        ~(^|,)(h2|http/1\.1)(,|$) 127.0.0.1:8443;
        "" $sni_backend;
        default 127.0.0.1:5349;
    }
    # Plain HTTP uses this SAME public socket, only to bootstrap CA/HTTPS.
    map $ssl_preread_protocol $entry_backend {
        "" 127.0.0.1:8081;
        default $tls_backend;
    }
    # A variable proxy_pass resolves Docker DNS again after container changes.
    map $remote_addr $classifier_backend { default classifier:3479; }
    server {
        listen 443;
        ssl_preread on;
        proxy_connect_timeout 5s;
        proxy_timeout 3600s;
        proxy_pass $entry_backend;
    }
    server {
        listen 127.0.0.1:5349 ssl;
        ssl_certificate /run/relay/tls.crt;
        ssl_certificate_key /run/relay/tls.key;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_session_cache shared:TURN:10m;
        ssl_session_tickets off;
        ssl_handshake_timeout 10s;
        proxy_connect_timeout 5s;
        proxy_timeout 3600s;
        proxy_pass $classifier_backend;
    }
}

http {
    # Never log query strings, credentials, Authorization or cookies.
    log_format relay '$request_method $uri $status';
    access_log /dev/stdout relay;
    client_body_temp_path /tmp/client_temp;
    proxy_temp_path /tmp/proxy_temp;
    resolver 127.0.0.11 valid=10s ipv6=off;
    map $http_upgrade $connection_upgrade { default upgrade; '' close; }
    map $http_host $valid_host { default 0; "@PUBLIC_AUTHORITY@" 1; }
    map $http_host $valid_http_host { default 0; "@HTTP_AUTHORITY@" 1; }
    server {
        listen 127.0.0.1:8081;
        server_name @APP_HOST@;
        if ($valid_http_host = 0) { return 421; }
        # Exact certificate-only alias is generated ONLY in explicit LAN dev mode.
        @DEV_CA_LOCATION@
        location / { return 308 https://@PUBLIC_AUTHORITY@$request_uri; }
    }
    server {
        listen 127.0.0.1:8443 ssl;
        # Reachable only on the private bridge, AFTER the stream TLS terminator.
        listen 8082;
        server_name @APP_HOST@;
        ssl_certificate /run/relay/tls.crt;
        ssl_certificate_key /run/relay/tls.key;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_session_cache shared:HTTPS:10m;
        ssl_session_tickets off;
        if ($valid_host = 0) { return 421; }
        absolute_redirect off;
        client_max_body_size 100m;

        set $manager http://neko-rooms:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        # Both listeners carry public HTTPS; :8082 must not report its local
        # cleartext $scheme to Manager (Owner Origin and Secure cookies).
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port @PUBLIC_PORT@;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Forwarded "";
        # Set at server level: a child proxy_set_header would discard inherited
        # Upgrade/Connection/Host headers and break native WebSocket handshakes.
        proxy_set_header Accept-Encoding "";
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
        proxy_redirect off;

        location = / { return 302 /manage/; }
        location = /manage { return 308 /manage/; }
        # Manager owns the original viewer/signaling and separate Owner/Agent auth.
        location /manage/ { proxy_pass $manager$request_uri; }
        location = /.neko/room-ice.js { alias /run/relay/room-ice.js; default_type application/javascript; add_header Cache-Control "no-store" always; }
        location /room/ {
            sub_filter_once on;
            sub_filter '<head>' '<head><script src="/.neko/room-ice.js"></script>';
            proxy_pass $manager$request_uri;
        }
        location /rooms/  { proxy_pass $manager$request_uri; }
        location / { return 404; }
    }
}
