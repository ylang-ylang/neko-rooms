# Plain entry or the optional TLS terminator sends streams here. Classify the
# first request, then relay the entire connection unchanged (HTTP keepalive,
# WebSocket upgrades and subsequent TURN ChannelData are not re-classified).
global
    log stdout format raw local0

defaults
    mode tcp
    log global
    option tcplog
    timeout connect 5s
    timeout client 3600s
    timeout server 3600s

# The gateway depends on this service: do not resolve its name synchronously at
# startup. Docker DNS discovers/re-discovers both backends without fixed IPs.
resolvers docker
    nameserver embedded 127.0.0.11:53
    resolve_retries 3
    timeout resolve 1s
    timeout retry 1s
    hold valid 10s
    hold nx 1s
    hold refused 1s
    hold timeout 1s
    hold other 1s

frontend shared_tcp
    bind :3479
    tcp-request inspect-delay 5s
    acl is_http req.proto_http
    acl stun_header req.len ge 20
    acl stun_cookie req.payload(4,4) -m bin 2112a442
    tcp-request content accept if is_http
    tcp-request content accept if stun_header stun_cookie
    # Expiry, EOF or a full inspection buffer must never silently default to
    # TURN. Incomplete/unknown initial traffic is rejected explicitly.
    tcp-request content reject if WAIT_END
    use_backend http_backend if is_http
    use_backend turn_backend if stun_header stun_cookie

backend http_backend
    server gateway gateway:8082 resolvers docker resolve-prefer ipv4 init-addr none

backend turn_backend
    server turn turn:3478 resolvers docker resolve-prefer ipv4 init-addr none
