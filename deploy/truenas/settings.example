# Copy to /mnt/ylangsPool/appdata/neko/native-relay.settings and chmod 600.
# Literal KEY=value, NOT shell/dotenv; no inline comments/quote stripping.
# No Owner/viewer password keys: existing rooms.env/neko.env remain authoritative.
# REQUIRED: choose a reachable DNS name or IP (e.g. 192.168.202.11).
# Default plain: HTTP/WS + TURN/TCP, no certificates/imports. TLS is opt-in.
# Blank TURN_HOST inherits APP_HOST. For TLS, Firefox requires a DNS TURN host.
TRANSPORT=plain
APP_HOST=
TURN_HOST=
PUBLIC_PORT=22222
PUBLIC_BIND_IP=192.168.202.11
# REQUIRED: inspect the subnet of the EXISTING neko-rooms-net; never recreate it.
ROOM_NETWORK_CIDR=
# Auto works on existing Docker-allocated subnets; no bridge recreation needed.
TURN_PRIVATE_IP=auto
# Existing fullchain/key covering APP_HOST and TURN_HOST. Keep the key private.
# Plain mode leaves both blank. TLS mode needs both or explicit --dev-ca.
TLS_CERT_FILE=
TLS_KEY_FILE=
# Normal redeploy follows public channels; existing rooms are NOT auto-recreated.
# For rollback/version lock, replace BOTH with published immutable refs/digests.
MANAGER_IMAGE=docker.io/ylangylang/neko-rooms:single-port
ROOM_IMAGE=docker.io/ylangylang/neko-chromium-cdp:single-port
# Explicit offline archive load: set never ONLY after all referenced images exist.
RELEASE_PULL_POLICY=always
