worker_processes auto;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 4096; }
stream {
    resolver 127.0.0.11 valid=10s ipv6=off;
    map $remote_addr $classifier_backend { default classifier:3479; }
    server {
        listen 443;
        proxy_connect_timeout 5s;
        proxy_timeout 3600s;
        proxy_pass $classifier_backend;
    }
}
http {
    log_format relay '$request_method $uri $status';
    access_log /dev/stdout relay;
    client_body_temp_path /tmp/client_temp;
    proxy_temp_path /tmp/proxy_temp;
    resolver 127.0.0.11 valid=10s ipv6=off;
    map $http_upgrade $connection_upgrade { default upgrade; '' close; }
    map $http_host $valid_host { default 0; "@PUBLIC_AUTHORITY@" 1; }
    server {
        listen 8082;
        server_name @APP_HOST@;
        if ($valid_host = 0) { return 421; }
        absolute_redirect off;
        client_max_body_size 100m;
        set $manager http://neko-rooms:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto http;
        proxy_set_header X-Forwarded-Port @PUBLIC_PORT@;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Forwarded "";
        # Set at server level: a child proxy_set_header would discard inherited
        # Upgrade/Connection/Host headers and break native WebSocket handshakes.
        proxy_set_header Accept-Encoding "";
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
        proxy_redirect off;
        location = / { return 302 /manage/; }
        location = /manage { return 308 /manage/; }
        location = /.neko/room-ice.js {
            alias /run/relay/room-ice.js;
            default_type application/javascript;
            add_header Cache-Control "no-store" always;
        }
        location /manage/ { proxy_pass $manager$request_uri; }
        location /room/ {
            sub_filter_once on;
            sub_filter '<head>' '<head><script src="/.neko/room-ice.js"></script>';
            proxy_pass $manager$request_uri;
        }
        location /rooms/ { proxy_pass $manager$request_uri; }
        location / { return 404; }
    }
}
