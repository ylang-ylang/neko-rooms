# Copy OUTSIDE the checkout and chmod 600. One literal KEY=value per line;
# optional matching quotes; no shell expansion, escapes or multiline values.
# Empty required values deliberately fail configure.py. Supply the REAL gateway,
# DNS hostname and matching certificate before public deployment is possible.
PUBLIC_HOST=
HTTPS_PORT=443
TURNS_PORT=5349
# Stage on loopback first. Change only on the approved gateway at activation.
PUBLIC_BIND_IP=127.0.0.1
TLS_CERT_FILE=
TLS_KEY_FILE=

# An EXISTING private IPv4 Docker bridge used by dynamically created rooms.
# Read its real subnet with docker network inspect. Never guess another host's
# CIDR. TURN_PRIVATE_IP must be unused, in this CIDR, preferably outside IPRange.
ROOM_NETWORK=
ROOM_NETWORK_CIDR=
TURN_PRIVATE_IP=
# This UDP range is PRIVATE ONLY: no host publishing, forwarding or WAN rule.
TURN_RELAY_MIN=49160
TURN_RELAY_MAX=49259

# Keep the current instance name and absolute host storage path when integrating
# an existing installation. Do not run two managers for the same instance.
INSTANCE_NAME=neko-rooms
STORAGE_PATH=
DOCKER_SOCKET=/var/run/docker.sock
MANAGER_IMAGE=truenas-neko-rooms-agent:1.6.5-3
ROOM_IMAGE=truenas-neko-chromium-cdp:3.2.0-1

# Use ONLY the existing configured owner's credentials. Not a new account.
# These remain private; they must never appear in an Agent handoff prompt.
OWNER_USERNAME=
OWNER_PASSWORD=
# Leave blank on first configure: strong TURN-only credentials are generated
# once and reused from the private output directory. Not the owner's password.
TURN_USERNAME=
TURN_PASSWORD=
