# Copy OUTSIDE the checkout; chmod 600. Literal KEY=value, NOT shell/dotenv:
# quotes, dollars, backslashes and # inside a value are actual characters.
# Do not source this file; no interpolation or quote stripping is performed.
APP_HOST=neko.localhost
TURN_HOST=turn.localhost
PUBLIC_PORT=8443
PUBLIC_BIND_IP=127.0.0.1
# Direct LAN: set PUBLIC_BIND_IP=0.0.0.0 (or your LAN IP), then configure with
# --lan-ip 192.168.201.237 --turn-host <client-resolvable-FQDN> --dev-ca --public.
# Web stays on the IP; Firefox TURN/TLS needs a FQDN resolving to that LAN IP.
# Omitting --turn-host keeps IP TURN only for clients that support it; LAN mode
# never inherits this file's TURN_HOST. No DNS/hosts changes or extra ports.

# Required: local manager image built from THIS checkout's Dockerfile.
MANAGER_IMAGE=
ROOM_IMAGE=ghcr.io/m1k1o/neko/chromium:3.2.0@sha256:270face8b8111e639744fb7bcdbbf0deed227900bb89d58b2f8adfc12af8c41e
# Explicit EXISTING bridge + actual subnet + unused static address, not gateway.
# No network is auto-selected or created by demo.py.
ROOM_NETWORK=
ROOM_NETWORK_CIDR=
TURN_PRIVATE_IP=
INSTANCE_NAME=neko-single-port
DOCKER_SOCKET=/var/run/docker.sock
TURN_RELAY_MIN=49160
TURN_RELAY_MAX=49259

# --dev-ca generates/reuses a private CA + SAN cert (.localhost or LAN IP + TURN DNS).
# Add --renew-server-cert only to explicitly replace the leaf for changed SANs
# or expiry; existing CA, server key, saved credentials and storage stay intact.
# LAN-dev public CA download: http://<LAN-IP>:<PUBLIC_PORT>/ca.crt (certificate ONLY).
# Without --dev-ca, supply real DNS names and an unexpired PEM fullchain/key.
TLS_CERT_FILE=
TLS_KEY_FILE=

# Blank on first configure generates NEW demo credentials; later runs reuse.
# Optional owner/TURN pairs must be complete; changing saved credentials fails.
# Native viewer user/admin passwords are independently generated in private state.
OWNER_USERNAME=
OWNER_PASSWORD=
TURN_USERNAME=
TURN_PASSWORD=
