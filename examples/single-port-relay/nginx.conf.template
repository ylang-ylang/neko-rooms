worker_processes auto;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 4096; }

stream {
    resolver 127.0.0.11 valid=10s ipv6=off;
    # Inspect ClientHello WITHOUT terminating TLS on the only public listener.
    # Chrome TURN/TLS may omit SNI: default MUST be TURN, not HTTPS.
    map $ssl_preread_server_name $tls_backend {
        @APP_HOST@ 127.0.0.1:8443;
        default 127.0.0.1:5349;
    }
    # A variable proxy_pass resolves Docker DNS again after container changes.
    map $remote_addr $turn_backend { default turn:3478; }
    server {
        listen 443;
        ssl_preread on;
        proxy_connect_timeout 5s;
        proxy_timeout 3600s;
        proxy_pass $tls_backend;
    }
    server {
        listen 127.0.0.1:5349 ssl;
        ssl_certificate /run/relay/tls.crt;
        ssl_certificate_key /run/relay/tls.key;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_session_cache shared:TURN:10m;
        ssl_session_tickets off;
        ssl_handshake_timeout 10s;
        proxy_connect_timeout 5s;
        proxy_timeout 3600s;
        proxy_pass $turn_backend;
    }
}

http {
    # Never log query strings, credentials, Authorization or cookies.
    log_format relay '$request_method $uri $status';
    access_log /dev/stdout relay;
    client_body_temp_path /tmp/client_temp;
    proxy_temp_path /tmp/proxy_temp;
    resolver 127.0.0.11 valid=10s ipv6=off;
    map $http_upgrade $connection_upgrade { default upgrade; '' close; }
    map $http_host $valid_host { default 0; "@PUBLIC_AUTHORITY@" 1; }
    server {
        listen 127.0.0.1:8443 ssl;
        server_name @APP_HOST@;
        ssl_certificate /run/relay/tls.crt;
        ssl_certificate_key /run/relay/tls.key;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_session_cache shared:HTTPS:10m;
        ssl_session_tickets off;
        if ($valid_host = 0) { return 421; }
        absolute_redirect off;
        client_max_body_size 100m;

        set $manager http://neko-rooms:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port @PUBLIC_PORT@;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Forwarded "";
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
        proxy_redirect off;

        location = / { return 302 /manage/; }
        location = /manage { return 308 /manage/; }
        # Manager owns the original viewer/signaling and separate Owner/Agent auth.
        location /manage/ { proxy_pass $manager$request_uri; }
        location /room/   { proxy_pass $manager$request_uri; }
        location /rooms/  { proxy_pass $manager$request_uri; }
        location / { return 404; }
    }
}
